# =============================================================================
# .env.example - TEMPLATE de variaveis de ambiente para o Docker Compose
# seguro (docker-compose.secure.yml) do Encontro 11.
#
# COMO USAR:
#   1. Copie este arquivo para ".env" no mesmo diretorio:
#        cp .env.example .env
#   2. Preencha ".env" com valores proprios (mesmo em ambiente de estudo,
#      evite reaproveitar senhas que voce usa em serviços reais).
#   3. O arquivo ".env" (sem o ".example") NUNCA deve ser commitado -
#      confirme que ele esta listado no .gitignore do seu repositorio.
#
# POR QUE ISSO IMPORTA:
#   Este arquivo (.env.example) e seguro para versionar porque nao contem
#   nenhum segredo real - apenas os NOMES das variaveis que a aplicacao e o
#   banco de dados esperam encontrar. Quem clona o repositorio sabe
#   exatamente quais variaveis precisa configurar, sem nunca ter acesso a
#   nenhuma credencial real de ninguem.
# =============================================================================

# Credenciais do banco de dados PostgreSQL (servico "db" no compose).
# Nunca reutilize estes valores de exemplo em um ambiente real.
POSTGRES_USER=taskflow_admin
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui
POSTGRES_DB=taskflow

# Segredo de sessao da aplicacao Flask (equivalente ao SECRET_KEY que, na
# versao original do TaskFlow em app-exemplo/app.py, esta hardcoded no
# codigo-fonte - ver Modulo 1/3). Aqui ele passa a ser injetado em tempo de
# execucao via variavel de ambiente, nunca commitado.
SECRET_KEY=troque-por-um-valor-aleatorio-longo-aqui
